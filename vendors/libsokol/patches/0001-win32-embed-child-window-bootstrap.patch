diff --git a/sokol_app.h b/sokol_app.h
--- a/sokol_app.h
+++ b/sokol_app.h
@@ -2460,6 +2460,8 @@
     #endif
     #include <windows.h>
     #include <windowsx.h>
+    #include "platform/win32_embed.h"
     #include <shellapi.h>
 
     #if defined(__GNUC__)
@@ -9734,11 +9736,35 @@ _SOKOL_PRIVATE void _sapp_win32_create_window(void) {
        windowed-mode window will always be created first (however in hidden
        mode, so that no windowed-mode window pops up before the fullscreen window)
     */
-    const DWORD win_ex_style = WS_EX_APPWINDOW | WS_EX_WINDOWEDGE;
+    const bool embed_window = mdcad_win32_embed_is_enabled();
+    DWORD win_ex_style = WS_EX_APPWINDOW | WS_EX_WINDOWEDGE;
     RECT rect = { 0, 0, 0, 0 };
     DWORD win_style = WS_CLIPSIBLINGS | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_SIZEBOX;
-    rect.right = (int) ((float)_sapp.window_width * _sapp.win32.dpi.window_scale);
-    rect.bottom = (int) ((float)_sapp.window_height * _sapp.win32.dpi.window_scale);
+    HWND parent_hwnd = NULL;
+    int window_x = CW_USEDEFAULT;
+    int window_y = SW_HIDE;
+    int window_width = 0;
+    int window_height = 0;
+    if (embed_window) {
+        parent_hwnd = mdcad_win32_embed_parent_hwnd();
+        if (!IsWindow(parent_hwnd)) {
+            mdcad_win32_embed_fail_startup("Embedded startup failed: invalid parent HWND");
+        }
+        if (!GetClientRect(parent_hwnd, &rect)) {
+            mdcad_win32_embed_fail_startup("Embedded startup failed: GetClientRect failed for parent HWND");
+        }
+        if ((rect.right <= rect.left) || (rect.bottom <= rect.top)) {
+            mdcad_win32_embed_fail_startup("Embedded startup failed: parent HWND has no client area");
+        }
+        win_ex_style = 0;
+        win_style = WS_CHILD | WS_VISIBLE | WS_CLIPSIBLINGS | WS_CLIPCHILDREN;
+        window_x = 0;
+        window_y = 0;
+        window_width = rect.right - rect.left;
+        window_height = rect.bottom - rect.top;
+    }
+    else {
+        rect.right = (int) ((float)_sapp.window_width * _sapp.win32.dpi.window_scale);
+        rect.bottom = (int) ((float)_sapp.window_height * _sapp.win32.dpi.window_scale);
+    }
     const bool use_default_width = 0 == _sapp.window_width;
     const bool use_default_height = 0 == _sapp.window_height;
     AdjustWindowRectEx(&rect, win_style, FALSE, win_ex_style);
@@ -9748,20 +9774,32 @@ _SOKOL_PRIVATE void _sapp_win32_create_window(void) {
     _sapp.win32.in_create_window = true;
     _sapp.win32.surrogate = 0;
     _sapp.win32.hwnd = CreateWindowExW(
-        win_ex_style,               // dwExStyle
-        L"SOKOLAPP",                // lpClassName
-        _sapp.window_title_wide,    // lpWindowName
-        win_style,                  // dwStyle
-        CW_USEDEFAULT,              // X
-        SW_HIDE,                    // Y (NOTE: CW_USEDEFAULT is not used for position here, but internally calls ShowWindow!
-        use_default_width ? CW_USEDEFAULT : win_width, // nWidth
-        use_default_height ? CW_USEDEFAULT : win_height, // nHeight (NOTE: if width is CW_USEDEFAULT, height is actually ignored)
-        NULL,                       // hWndParent
+        win_ex_style,                               // dwExStyle
+        L"SOKOLAPP",                                // lpClassName
+        _sapp.window_title_wide,                    // lpWindowName
+        win_style,                                  // dwStyle
+        window_x,                                   // X
+        window_y,                                   // Y
+        embed_window ? window_width : (use_default_width ? CW_USEDEFAULT : win_width), // nWidth
+        embed_window ? window_height : (use_default_height ? CW_USEDEFAULT : win_height), // nHeight
+        embed_window ? parent_hwnd : NULL,          // hWndParent
         NULL,                       // hMenu
         GetModuleHandle(NULL),      // hInstance
         NULL);                      // lParam
     _sapp.win32.in_create_window = false;
+    if (!_sapp.win32.hwnd && embed_window) {
+        mdcad_win32_embed_fail_startup("Embedded startup failed: CreateWindowExW failed for child window");
+    }
     _sapp.win32.dc = GetDC(_sapp.win32.hwnd);
+    if (!_sapp.win32.dc && embed_window) {
+        mdcad_win32_embed_fail_startup("Embedded startup failed: GetDC failed for child window");
+    }
     _sapp.win32.hmonitor = MonitorFromWindow(_sapp.win32.hwnd, MONITOR_DEFAULTTONULL);
     SOKOL_ASSERT(_sapp.win32.dc);
 
@@ -9770,10 +9808,14 @@ _SOKOL_PRIVATE void _sapp_win32_create_window(void) {
        restore the window position when switching back to windowed
     */
     _sapp_win32_update_dimensions();
-    if (_sapp.fullscreen) {
+    if (_sapp.fullscreen && !embed_window) {
         _sapp_win32_set_fullscreen(_sapp.fullscreen, SWP_HIDEWINDOW);
         _sapp_win32_update_dimensions();
     }
-    ShowWindow(_sapp.win32.hwnd, SW_SHOW);
-    DragAcceptFiles(_sapp.win32.hwnd, 1);
+    if (!embed_window) {
+        ShowWindow(_sapp.win32.hwnd, SW_SHOW);
+        DragAcceptFiles(_sapp.win32.hwnd, 1);
+    }
 }
