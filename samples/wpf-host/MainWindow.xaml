<Window x:Class="WpfHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mdcad="clr-namespace:MdCad.Wpf.Control;assembly=MdCad.Wpf.Control"
        Title="mdCAD WPF Host"
        Width="1280"
        Height="720"
        MinWidth="820"
        MinHeight="520">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="12"
                BorderThickness="1"
                BorderBrush="#3A3A3A">
            <StackPanel>
                <TextBlock FontSize="18"
                           FontWeight="SemiBold"
                           Text="Reusable mdCAD WPF control harness" />
                <WrapPanel Margin="0,12,0,0">
                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Text="Presentation:" />
                    <ComboBox x:Name="PresentationModeComboBox"
                              Width="160"
                              Margin="0,0,12,8"
                              SelectionChanged="OnPresentationModeChanged">
                        <ComboBoxItem Content="Sealed" />
                        <ComboBoxItem Content="Diagnostic" />
                    </ComboBox>
                    <CheckBox x:Name="AutoStartCheckBox"
                              Margin="0,0,12,8"
                              VerticalAlignment="Center"
                              Content="AutoStart"
                              Checked="OnAutoStartToggleChanged"
                              Unchecked="OnAutoStartToggleChanged" />
                    <CheckBox x:Name="LiveRefreshCheckBox"
                              Margin="0,0,12,8"
                              VerticalAlignment="Center"
                              Content="Live refresh"
                              Checked="OnLiveRefreshToggleChanged"
                              Unchecked="OnLiveRefreshToggleChanged" />
                    <CheckBox x:Name="ViewportOnlyCheckBox"
                              Margin="0,0,12,8"
                              VerticalAlignment="Center"
                              Content="Viewport only"
                              Checked="OnViewportOnlyToggleChanged"
                              Unchecked="OnViewportOnlyToggleChanged" />
                </WrapPanel>

                <WrapPanel Margin="0,4,0,0">
                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Text="Jsonl scenario:" />
                    <ComboBox x:Name="JsonlScenarioComboBox"
                              Width="240"
                              Margin="0,0,12,8"
                              SelectionChanged="OnJsonlScenarioChanged">
                        <ComboBoxItem Content="Bundled example" />
                        <ComboBoxItem Content="Empty request" />
                        <ComboBoxItem Content="Missing file" />
                        <ComboBoxItem Content="Unreadable directory" />
                    </ComboBox>
                    <Button x:Name="StartViewerButton"
                            Width="96"
                            Margin="0,0,8,8"
                            Content="StartAsync"
                            Click="OnStartViewerClick" />
                    <Button x:Name="StopViewerButton"
                            Width="96"
                            Margin="0,0,8,8"
                            Content="StopAsync"
                            Click="OnStopViewerClick" />
                </WrapPanel>

                <TextBlock x:Name="RuntimeStatusTextBlock"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="HarnessStatusTextBlock"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Padding="8"
                BorderThickness="1"
                BorderBrush="#3A3A3A">
            <mdcad:MdCadEmbeddedControl x:Name="EmbeddedControl"
                                        PresentationMode="Diagnostic" />
        </Border>
    </Grid>
</Window>
