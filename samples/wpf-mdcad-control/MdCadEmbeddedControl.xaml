<UserControl x:Class="MdCad.Wpf.Control.MdCadEmbeddedControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="360"
             d:DesignWidth="520">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#111827"
                BorderBrush="#1F2937"
                BorderThickness="1">
            <ContentControl x:Name="EmbedSurfaceContainer"
                            Focusable="False" />
        </Border>

        <StackPanel Grid.Row="1"
                    Margin="0,8,0,0">
            <Border x:Name="WarningSurface"
                    Background="#FEF3C7"
                    BorderBrush="#F59E0B"
                    BorderThickness="1"
                    Padding="8"
                    Visibility="Collapsed">
                <TextBlock x:Name="WarningTextBlock"
                           TextWrapping="Wrap" />
            </Border>

            <Border x:Name="DiagnosticSurface"
                    Margin="0,8,0,0"
                    Padding="8"
                    Background="#0F172A"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,8">
                        <Button x:Name="DiagnosticStartButton"
                                Width="80"
                                Margin="0,0,8,0"
                                Content="Start" />
                        <Button x:Name="DiagnosticStopButton"
                                Width="80"
                                Content="Stop" />
                    </StackPanel>
                    <TextBlock x:Name="LaunchStatusTextBlock"
                               Foreground="White"
                               Margin="0,0,0,4" />
                    <TextBlock x:Name="AttachStatusTextBlock"
                               Foreground="White"
                               Margin="0,0,0,4" />
                    <TextBlock x:Name="JsonlStatusTextBlock"
                               Foreground="White"
                               Margin="0,0,0,4" />
                    <TextBlock x:Name="LiveRefreshStatusTextBlock"
                               Foreground="White"
                               Margin="0,0,0,4" />
                    <TextBlock x:Name="FailureTextBlock"
                               Foreground="White"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
