<Window x:Class="WpfHostMinimal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mdcad="clr-namespace:MdCad.Wpf.Control;assembly=MdCad.Wpf.Control"
        mc:Ignorable="d"
        Title="mdCAD Minimal WPF Host"
        Width="1280"
        Height="720"
        MinWidth="720"
        MinHeight="480">
    <Grid Margin="12">
        <mdcad:MdCadEmbeddedControl PresentationMode="Sealed"
                                    AutoStart="True"
                                    ViewportOnlyStartupMode="False" 
                                    StartupLiveRefreshEnabled="False"
                                    JsonlPath="{Binding JsonlPath}" />
    </Grid>
</Window>
