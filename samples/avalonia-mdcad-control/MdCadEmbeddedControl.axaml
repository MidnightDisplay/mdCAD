<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MdCad.Avalonia.Control.MdCadEmbeddedControl">
  <Grid RowDefinitions="Auto,*">
    <Border x:Name="WarningSurface"
            Margin="0,0,0,8"
            Padding="8"
            IsVisible="False"
            Background="#2D1E1E"
            BorderBrush="#AA5A5A"
            BorderThickness="1">
      <TextBlock x:Name="WarningTextBlock"
                 TextWrapping="Wrap" />
    </Border>

    <Border Grid.Row="1"
            Padding="8"
            BorderThickness="1"
            BorderBrush="#3A3A3A">
      <ContentControl x:Name="EmbedSurfaceContainer" />
    </Border>
  </Grid>
</UserControl>
