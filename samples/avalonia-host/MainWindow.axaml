<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:AvaloniaHost"
        x:Class="AvaloniaHost.MainWindow"
        Width="1280"
        Height="720"
        MinWidth="720"
        MinHeight="480"
        Title="mdCAD Avalonia Host">
  <Grid RowDefinitions="Auto,*" Margin="12">
    <Border x:Name="HostChrome"
            Focusable="True"
            PointerPressed="OnHostChromePointerPressed">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="LaunchSessionButton"
                  Content="Launch Session"
                  Click="OnLaunchSessionClick" />
          <Button x:Name="CloseSessionButton"
                  Content="Close Session"
                  Click="OnCloseSessionClick" />
          <CheckBox x:Name="LiveRefreshCheckBox"
                    Content="Live refresh"
                    Checked="OnLiveRefreshToggleChanged"
                    Unchecked="OnLiveRefreshToggleChanged" />
        </StackPanel>
        <TextBlock x:Name="StatusTextBlock"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Text="launch: idle" />
        <TextBlock x:Name="ModeTextBlock" />
        <TextBlock x:Name="JsonlStatusTextBlock"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="LiveRefreshStatusTextBlock" />
        <TextBlock x:Name="FailureTextBlock"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1"
            Margin="0,12,0,0"
            Padding="8"
            BorderThickness="1"
            BorderBrush="#3A3A3A">
      <ContentControl x:Name="EmbedSurfaceHost" />
    </Border>
  </Grid>
</Window>
