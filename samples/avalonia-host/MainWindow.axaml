<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mdcad="clr-namespace:MdCad.Avalonia.Control;assembly=MdCad.Avalonia.Control"
        x:Class="AvaloniaHost.MainWindow"
        Width="1280"
        Height="720"
        MinWidth="720"
        MinHeight="480"
        Title="mdCAD Avalonia Host">
  <Grid RowDefinitions="Auto,*" Margin="12">
    <Border Padding="12"
            BorderThickness="1"
            BorderBrush="#3A3A3A">
      <StackPanel Spacing="10">
        <TextBlock Text="Reusable mdCAD control harness"
                   FontSize="18"
                   FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock VerticalAlignment="Center"
                     Text="Presentation:" />
          <ComboBox x:Name="PresentationModeComboBox"
                    Width="160"
                    SelectionChanged="OnPresentationModeChanged">
            <ComboBoxItem Content="Sealed" />
            <ComboBoxItem Content="Diagnostic" />
          </ComboBox>
          <CheckBox x:Name="AutoStartCheckBox"
                    Content="AutoStart"
                    Checked="OnAutoStartToggleChanged"
                    Unchecked="OnAutoStartToggleChanged" />
          <CheckBox x:Name="LiveRefreshCheckBox"
                    Content="Live refresh"
                    Checked="OnLiveRefreshToggleChanged"
                    Unchecked="OnLiveRefreshToggleChanged" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock VerticalAlignment="Center"
                     Text="Jsonl scenario:" />
          <ComboBox x:Name="JsonlScenarioComboBox"
                    Width="240"
                    SelectionChanged="OnJsonlScenarioChanged">
            <ComboBoxItem Content="Bundled example" />
            <ComboBoxItem Content="Empty request" />
            <ComboBoxItem Content="Missing file" />
            <ComboBoxItem Content="Unreadable directory" />
          </ComboBox>
          <Button x:Name="StartViewerButton"
                  Content="StartAsync"
                  Click="OnStartViewerClick" />
          <Button x:Name="StopViewerButton"
                  Content="StopAsync"
                  Click="OnStopViewerClick" />
        </StackPanel>
        <TextBlock x:Name="RuntimeStatusTextBlock"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="HarnessStatusTextBlock"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1"
            Margin="0,12,0,0"
            Padding="8"
            BorderThickness="1"
            BorderBrush="#3A3A3A">
      <mdcad:MdCadEmbeddedControl x:Name="EmbeddedControl"
                                  PresentationMode="Diagnostic" />
    </Border>
  </Grid>
</Window>
