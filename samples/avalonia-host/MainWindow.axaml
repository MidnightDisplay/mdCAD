<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:AvaloniaHost"
        x:Class="AvaloniaHost.MainWindow"
        Width="1280"
        Height="720"
        MinWidth="720"
        MinHeight="480"
        Title="mdCAD Avalonia Host">
  <Grid RowDefinitions="Auto,*" Margin="12">
    <Border x:Name="HostChrome"
            Focusable="True"
            PointerPressed="OnHostChromePointerPressed">
      <StackPanel Spacing="4">
        <TextBlock x:Name="StatusTextBlock"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Text="launching" />
        <TextBlock x:Name="ModeTextBlock" />
        <TextBlock x:Name="FailureTextBlock"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1"
            Margin="0,12,0,0"
            Padding="8"
            BorderThickness="1"
            BorderBrush="#3A3A3A">
      <local:EmbedNativeControlHost x:Name="EmbedSurface" />
    </Border>
  </Grid>
</Window>
