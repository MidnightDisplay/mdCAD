diff --git a/sokol_app.h b/sokol_app.h
--- a/sokol_app.h
+++ b/sokol_app.h
@@ -10173,16 +10173,130 @@ _SOKOL_PRIVATE bool _sapp_android_touch_event(const AInputEvent* e) {
     return true;
 }

+// Translate Android keycode to Sokol keycode
+_SOKOL_PRIVATE sapp_keycode _sapp_android_translate_key(int32_t android_key) {
+    switch (android_key) {
+        case 19: return SAPP_KEYCODE_UP;         // AKEYCODE_DPAD_UP
+        case 20: return SAPP_KEYCODE_DOWN;       // AKEYCODE_DPAD_DOWN
+        case 21: return SAPP_KEYCODE_LEFT;       // AKEYCODE_DPAD_LEFT
+        case 22: return SAPP_KEYCODE_RIGHT;      // AKEYCODE_DPAD_RIGHT
+        case 23: return SAPP_KEYCODE_ENTER;      // AKEYCODE_DPAD_CENTER
+        case 66: return SAPP_KEYCODE_ENTER;      // AKEYCODE_ENTER
+        case 67: return SAPP_KEYCODE_BACKSPACE;  // AKEYCODE_DEL
+        case 61: return SAPP_KEYCODE_TAB;        // AKEYCODE_TAB
+        case 62: return SAPP_KEYCODE_SPACE;      // AKEYCODE_SPACE
+        case 111: return SAPP_KEYCODE_ESCAPE;    // AKEYCODE_ESCAPE
+        // Letters A-Z (AKEYCODE_A=29 to AKEYCODE_Z=54)
+        case 29: return SAPP_KEYCODE_A;
+        case 30: return SAPP_KEYCODE_B;
+        case 31: return SAPP_KEYCODE_C;
+        case 32: return SAPP_KEYCODE_D;
+        case 33: return SAPP_KEYCODE_E;
+        case 34: return SAPP_KEYCODE_F;
+        case 35: return SAPP_KEYCODE_G;
+        case 36: return SAPP_KEYCODE_H;
+        case 37: return SAPP_KEYCODE_I;
+        case 38: return SAPP_KEYCODE_J;
+        case 39: return SAPP_KEYCODE_K;
+        case 40: return SAPP_KEYCODE_L;
+        case 41: return SAPP_KEYCODE_M;
+        case 42: return SAPP_KEYCODE_N;
+        case 43: return SAPP_KEYCODE_O;
+        case 44: return SAPP_KEYCODE_P;
+        case 45: return SAPP_KEYCODE_Q;
+        case 46: return SAPP_KEYCODE_R;
+        case 47: return SAPP_KEYCODE_S;
+        case 48: return SAPP_KEYCODE_T;
+        case 49: return SAPP_KEYCODE_U;
+        case 50: return SAPP_KEYCODE_V;
+        case 51: return SAPP_KEYCODE_W;
+        case 52: return SAPP_KEYCODE_X;
+        case 53: return SAPP_KEYCODE_Y;
+        case 54: return SAPP_KEYCODE_Z;
+        // Numbers 0-9 (AKEYCODE_0=7 to AKEYCODE_9=16)
+        case 7: return SAPP_KEYCODE_0;
+        case 8: return SAPP_KEYCODE_1;
+        case 9: return SAPP_KEYCODE_2;
+        case 10: return SAPP_KEYCODE_3;
+        case 11: return SAPP_KEYCODE_4;
+        case 12: return SAPP_KEYCODE_5;
+        case 13: return SAPP_KEYCODE_6;
+        case 14: return SAPP_KEYCODE_7;
+        case 15: return SAPP_KEYCODE_8;
+        case 16: return SAPP_KEYCODE_9;
+        // Gamepad buttons - map to generic keys, store native code for lookup
+        case 96:  return SAPP_KEYCODE_ENTER;      // AKEYCODE_BUTTON_A
+        case 97:  return SAPP_KEYCODE_ESCAPE;     // AKEYCODE_BUTTON_B
+        case 99:  return SAPP_KEYCODE_X;          // AKEYCODE_BUTTON_X
+        case 100: return SAPP_KEYCODE_Y;          // AKEYCODE_BUTTON_Y
+        case 102: return SAPP_KEYCODE_LEFT_SHIFT; // AKEYCODE_BUTTON_L1
+        case 103: return SAPP_KEYCODE_RIGHT_SHIFT;// AKEYCODE_BUTTON_R1
+        case 108: return SAPP_KEYCODE_ENTER;      // AKEYCODE_BUTTON_START
+        case 109: return SAPP_KEYCODE_TAB;        // AKEYCODE_BUTTON_SELECT
+        default: return SAPP_KEYCODE_INVALID;
+    }
+}
+
 _SOKOL_PRIVATE bool _sapp_android_key_event(const AInputEvent* e) {
     if (AInputEvent_getType(e) != AINPUT_EVENT_TYPE_KEY) {
         return false;
     }
-    if (AKeyEvent_getKeyCode(e) == AKEYCODE_BACK) {
-        /* FIXME: this should be hooked into a "really quit?" mechanism
-           so the app can ask the user for confirmation, this is currently
-           generally missing in sokol_app.h
-        */
+    const int32_t key = AKeyEvent_getKeyCode(e);
+    const int32_t action = AKeyEvent_getAction(e);
+
+    // Handle BACK key for app quit
+    if (key == AKEYCODE_BACK && action == AKEY_EVENT_ACTION_UP) {
         _sapp_android_shutdown();
         return true;
     }
-    return false;
+
+    // Translate to Sokol keycode
+    const sapp_keycode sokol_key = _sapp_android_translate_key(key);
+    if (sokol_key == SAPP_KEYCODE_INVALID) {
+        return false;
+    }
+
+    // Determine event type
+    sapp_event_type type;
+    switch (action) {
+        case AKEY_EVENT_ACTION_DOWN:
+            type = SAPP_EVENTTYPE_KEY_DOWN;
+            break;
+        case AKEY_EVENT_ACTION_UP:
+            type = SAPP_EVENTTYPE_KEY_UP;
+            break;
+        default:
+            return false;
+    }
+
+    // Check for repeat
+    const int32_t repeat_count = AKeyEvent_getRepeatCount(e);
+    const bool is_repeat = (repeat_count > 0);
+
+    // Build and dispatch event
+    _sapp_init_event(type);
+    _sapp.event.key_code = sokol_key;
+    _sapp.event.key_repeat = is_repeat;
+    _sapp.event.native_key_code = key;  // Store raw Android keycode
+
+    // Map modifier keys (simplified)
+    const int32_t meta = AKeyEvent_getMetaState(e);
+    if (meta & AMETA_SHIFT_ON) _sapp.event.modifiers |= SAPP_MODIFIER_SHIFT;
+    if (meta & AMETA_CTRL_ON) _sapp.event.modifiers |= SAPP_MODIFIER_CTRL;
+    if (meta & AMETA_ALT_ON) _sapp.event.modifiers |= SAPP_MODIFIER_ALT;
+
+    _sapp_call_event(&_sapp.event);
+    return true;
 }

 _SOKOL_PRIVATE int _sapp_android_input_cb(int fd, int events, void* data) {
